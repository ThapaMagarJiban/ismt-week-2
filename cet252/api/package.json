{
  "name": "book-library-api",
  "version": "1.0.0",
  "description": "Book Library REST API built with Node.js, Express and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:docs": "apidoc -i routes/ -o docs/",
    "test": "jest --runInBand --forceExit",
    "seed": "node db/seed.js"
  },
  "keywords": ["book", "library", "api", "nodejs", "express", "sqlite"],
  "author": "Book Library",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "apidoc": "^1.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
